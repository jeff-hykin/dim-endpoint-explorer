{
    "openapi": "3.1.0",
    "info": {
        "title": "dimOS Desktop",
        "version": "0.9.0"
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "tags": [
        {
            "name": "Apps",
            "description": "Install, update, start and stop apps. Each app is a git repo with a `dimos.yaml`; Desktop builds it with nix (`dimosApp`) and serves it under `/apps/<name>/`.",
            "x-family": "desktop"
        },
        {
            "name": "Notifications",
            "description": "The notification center. Apps post with `POST /api/notifications` (the dim-app SDK's `notify()`); every page hears `{type:\"notification\"}` on the events stream.",
            "x-family": "desktop"
        },
        {
            "name": "UI settings",
            "description": "Desktop-wide settings shared by every page: theme, OS notifications, network access (read-only here).",
            "x-family": "desktop"
        },
        {
            "name": "Topics (zenoh-web)",
            "description": "Live robot topics: the list, publish rates and one sampled message, read from zenoh through zenoh-web.",
            "x-family": "desktop"
        },
        {
            "name": "Events",
            "description": "`GET /api/events` is one Server-Sent Events stream for every page: apps, endpoints, blueprints, runs, notification, ui-settings, endpoint-stats.",
            "x-family": "desktop"
        },
        {
            "name": "Endpoints",
            "description": "The endpoint registry (Desktop's own + every app's manifest) and per-endpoint call counts.",
            "x-family": "desktop"
        },
        {
            "name": "MCP",
            "description": "`POST /mcp`: the Model Context Protocol server the agent uses. Its tools search and call the endpoints in the registry.",
            "x-family": "desktop"
        },
        {
            "name": "Blueprints",
            "description": "**Enumeration.** The dimos server lists every blueprint the checkout can run.\n\n**File watching.** A `notify` watcher on the checkout's blueprint sources and the venv's packages, debounced, sends `{type:\"blueprints\", added, removed}`.",
            "x-family": "dimos"
        },
        {
            "name": "Runs",
            "description": "Launch and stop blueprints. A launch goes through phases: `starting` → `running` → `stopped` or `failed`.",
            "x-family": "dimos"
        },
        {
            "name": "Logs",
            "description": "A run's structured log records, paged by offset and filtered by level or text.",
            "x-family": "dimos"
        },
        {
            "name": "Config",
            "description": "Config introspection: `introspect.py` runs in the checkout's python and reads each module's configurable args.",
            "x-family": "dimos"
        }
    ],
