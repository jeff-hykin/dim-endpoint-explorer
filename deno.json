{
    "tasks": {
        "dev": "deno run -A --watch backend/main.ts --port 8787",
        "mock": "deno run -A tests/mock_desktop.ts --port 7399",
        "fixtures": "deno run -A scripts/make_fixtures.ts",
        "test": "deno test -A backend/",
        "check": "deno check backend/main.ts tests/mock_desktop.ts && deno task check-endpoints",
        "check-endpoints": "deno run -A scripts/check_endpoints.ts"
    },
    "fmt": {
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 120,
        "exclude": [
            "frontend/dist",
            "frontend/node_modules",
            "icon.svg",
            "tests/fixtures"
        ]
    },
    "lint": {
        "exclude": [
            "frontend/dist",
            "frontend/node_modules"
        ]
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1",
        "@std/yaml": "jsr:@std/yaml@1",
        "playwright-core": "npm:playwright-core@1.56.0"
    }
}
